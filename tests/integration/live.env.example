# The harness never loads this file automatically. Export selected variables in
# the shell or inject them through a secret manager before `nox -s live`.

CEPH_TEST_URL=https://ceph.example.test:8443
CEPH_TEST_USERNAME_FILE=/absolute/path/to/ceph-dashboard-username
CEPH_TEST_PASSWORD_FILE=/absolute/path/to/ceph-dashboard-password

# Keep TLS verification enabled in normal environments. This false value is
# suitable only for an isolated disposable cluster with a self-signed cert.
CEPH_TEST_VERIFY=false

# Required before --ceph-live-mutate can run. Use the canonical cluster FSID.
CEPH_TEST_EXPECTED_FSID=11111111-2222-4333-8444-555555555555
# Declare only capabilities expected to work. Current-only routes have explicit
# names so a Reef run can omit them instead of reporting a false regression.
CEPH_TEST_FEATURES=orchestrator,health_snapshot,hardware

# Exact cleanup of UUID-named metadata created by the current test remains under
# --ceph-live-mutate. Changes to OSDs, hosts, pools, filesystems, service specs,
# or any pre-existing resource additionally require --ceph-live-destructive and
# both values below. Each test may touch only exact listed IDs; globs are rejected.
# Destructive HTTP writes currently remain fail-closed until the harness gains a
# reviewed rule for the exact method, route, payload, and owned resource.
# CEPH_TEST_DESTRUCTIVE_CONFIRM_FSID=11111111-2222-4333-8444-555555555555
# CEPH_TEST_DESTRUCTIVE_ALLOWLIST=pool:saltext-live,host:saltext-live-node
